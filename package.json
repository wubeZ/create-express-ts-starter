{
  "name": "@easy-starters/create-express-ts-starter",
  "version": "2.0.0",
  "description": "starter boilerplate with Typescript + Express 5 + Mongoose + MongoDB + Pino + Vitest",
  "bin": "./bin/script.js",
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wubeZ/create-express-ts-starter.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts | pino-pretty",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsc -p .",
    "prettier:fix": "prettier --write \"{src,tests}/**/*.ts\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "typescript",
    "express",
    "express5",
    "starter",
    "boilerplate",
    "mongoose",
    "mongodb",
    "atlas",
    "pino",
    "vitest",
    "eslint",
    "prettier",
    "husky",
    "tsx",
    "supertest"
  ],
  "author": "Wubshet Zeleke",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
